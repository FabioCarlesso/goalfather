# ─── Gradle / Kotlin / JVM ───
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/
*.class
out/
!**/src/main/**/adapter/out/
!**/src/main/**/adapter/out/**
# `out/` (acima) também capturava os ports de saída da camada application —
# reincluímos explicitamente para que o pacote port/out seja versionado.
!**/src/main/**/port/out/
!**/src/main/**/port/out/**
bin/

# ─── Spring Boot ───
*.log

# Banco H2 file-based de desenvolvimento (gerado em runtime pelo bootRun).
# Mantemos a pasta (via .gitkeep) mas ignoramos os arquivos do banco.
backend/data/*
!backend/data/.gitkeep
application-local.yml
application-local.properties

# ─── IntelliJ IDEA ───
.idea/
*.iml
*.iws
*.ipr

# ─── VS Code ───
.vscode/

# ─── Node / Vite / Frontend ───
node_modules/
dist/
dist-ssr/
.npm/
*.local
.vite/
coverage/
playwright-report/
test-results/
# tipos gerados a partir do contract/openapi.yaml (rodar `npm run gen:api`)
frontend/src/api/generated.d.ts

# ─── Sistema operacional ───
.DS_Store
Thumbs.db

# ─── Ambiente / segredos ───
.env
.env.*
!.env.example

# ─── Docker ───
*.pid
